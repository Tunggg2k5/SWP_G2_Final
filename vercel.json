{
  "version": 2,
  "builds": [
    {
      "src": "das-api/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "das-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/das-api/src/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/das-web/$1"
    }
  ]
}
